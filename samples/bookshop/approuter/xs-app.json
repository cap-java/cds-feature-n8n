{
  "welcomeFile": "/odata/v4/",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/actuator/(.*)$",
      "target": "/actuator/$1",
      "destination": "srv-api",
      "authenticationType": "none"
    }
  ]
}
